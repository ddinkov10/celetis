prefix_rule(
    pattern = ["scripts/celetis", "land"],
    decision = "allow",
)
prefix_rule(
    pattern = ["scripts/celetis", "--host", ["claude", "codex"], "land"],
    decision = "allow",
)
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Use scripts/celetis --host codex land from the main checkout.",
)
