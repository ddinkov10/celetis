{
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    ".claude",
    ".superpowers",
    "hooks/**",
    "board/board.ts",
    "board/view.ts",
    "board/ui.ts",
    "board/panel.ts",
    "board/palette.ts"
  ],
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "types": ["bun"]
  }
}
