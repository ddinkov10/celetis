{
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "files": {
    "includes": ["**"]
  },
  "linter": { "rules": { "suspicious": { "noImportCycles": "error" } } },
  "overrides": [
    {
      // The board and its read model remove or refuse control characters in agent, terminal, and link text; each such regex matches them on purpose (#84).
      "includes": ["engine/board/**", "engine/lib/board-read/board-read.ts"],
      "linter": { "rules": { "suspicious": { "noControlCharactersInRegex": "off" } } }
    },
    {
      "includes": ["engine/board/**"],
      "linter": { "rules": { "security": { "noDangerouslySetInnerHtml": "error" } } }
    },
    {
      // The host components render the markup of the old page once, and the old page modules fill it.
      "includes": ["engine/board/page/app/hosts.tsx"],
      "linter": { "rules": { "a11y": { "useHeadingContent": "off", "noNoninteractiveTabindex": "off" } } }
    },
    {
      // The rule order of board.css sets its cascade, and a reorder changes the board UI (#84).
      "includes": ["engine/board/page/board.css"],
      "linter": {
        "rules": { "style": { "noDescendingSpecificity": "off" }, "complexity": { "noImportantStyles": "off" } }
      }
    }
  ]
}
