#!/usr/bin/env bash

celetis_config_main() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
  dirname "$common"
}

celetis_config_read() (
  file="$1/.celetis.yaml"
  celetis_config_error() {
    printf 'celetis: %s: %s\n' "$file" "$*" >&2
    exit 2
  }
  [ -f "$file" ] && [ -r "$file" ] && [ ! -L "$file" ] ||
    celetis_config_error '<document>: need a regular, readable file, with no symlink'
  command -v yq >/dev/null 2>&1 ||
    celetis_config_error '<document>: need Mike Farah yq >=4.54.1,<5 on PATH'
  version=$(yq --version 2>/dev/null) ||
    celetis_config_error '<document>: cannot read the yq version'
  if [[ $version =~ ^yq\ \(https://github[.]com/mikefarah/yq/\)\ version\ v4[.]([0-9]+)[.]([0-9]+)$ ]] &&
    { [ "${BASH_REMATCH[1]}" -gt 54 ] ||
      { [ "${BASH_REMATCH[1]}" -eq 54 ] && [ "${BASH_REMATCH[2]}" -ge 1 ]; }; }; then
    :
  else
    celetis_config_error '<document>: need Mike Farah yq >=4.54.1,<5 on PATH'
  fi
  command -v jq >/dev/null 2>&1 || celetis_config_error '<document>: jq is not on PATH'
  umask 077
  scratch=$(mktemp -d) || celetis_config_error '<document>: cannot create a YAML snapshot'
  trap 'rm -rf "$scratch"' EXIT
  perl -e '
    use strict;
    use warnings;
    my $path = shift;
    my @before = lstat $path;
    @before && -f _ && !-l _ or die "not a regular file\n";
    open my $input, "<", $path or die "cannot open file: $!\n";
    my @opened = stat $input;
    $before[0] == $opened[0] && $before[1] == $opened[1] or die "file changed\n";
    binmode $input;
    binmode STDOUT;
    while (1) {
      my $count = read $input, my $bytes, 65536;
      defined $count or die "cannot read file: $!\n";
      last unless $count;
      print $bytes or die "cannot write snapshot: $!\n";
    }
    close $input or die "cannot close file: $!\n";
  ' "$file" >"$scratch/input.yaml" 2>"$scratch/read.err" ||
    celetis_config_error "<document>: $(cat "$scratch/read.err")"
  metadata=$(yq eval -o=json -I=0 '
    {"document": document_index,
     "nodes": [... | {"path": path, "key": is_key, "tag": tag, "kind": kind,
                     "style": style, "text": to_string}],
     "maps": [... | select(kind == "map") | {"path": path, "keys": (keys | map(to_string))}]}
  ' "$scratch/input.yaml" 2>"$scratch/yq.err") ||
    celetis_config_error "<document>: invalid YAML: $(cat "$scratch/yq.err")"
  problem=$(printf '%s\n' "$metadata" | jq -rs '
    def field: map(tostring) | join(".") | if . == "" then "<document>" else . end;
    if length != 1 then "<document>: need one YAML document"
    elif .[0].nodes[0].tag != "!!map" then "<document>: need a mapping root"
    else .[0] as $doc
      | [
          ($doc.nodes[] | select(.key and .tag != "!!str")
            | (.path | field) + ": mapping keys must be strings"),
          ($doc.maps[] | . as $map | .keys | group_by(.)[]
            | select(length > 1) | ($map.path + [.[0]] | field) + ": duplicate key"),
          ($doc.nodes[] | select(.kind == "alias")
            | (.path | field) + ": YAML aliases are not allowed"),
          ($doc.nodes[] | select(.tag | IN("!!map","!!seq","!!str","!!null","!!bool","!!int","!!float") | not)
            | (.path | field) + ": unsupported YAML tag"),
          ($doc.nodes[] | select(.tag == "!!float")
            | select(.text | ascii_downcase | test("^[+-]?[.](inf|nan)$"))
            | (.path | field) + ": non-finite numbers are not allowed"),
          ($doc.nodes[] | select(.key | not)
            | select(.path == ["worktreeSetup"] or (.path[0] == "custom" and (.path | length) == 2))
            | select(.style | contains("folded"))
            | (.path | field) + ": use a literal block for multiline text"),
          ($doc.nodes[] | select(.key | not) | select(.tag == "!!float")
            | select(.path == ["board","port"] or
                ((.path | length) == 4 and .path[0] == "codexProfiles" and
                 .path[2] == "reviewer" and .path[3] == "rank"))
            | (.path | field) + ": need an integer")
        ] | first // empty
    end
  ') || celetis_config_error '<document>: cannot validate YAML metadata'
  [ -z "$problem" ] || celetis_config_error "$problem"
  config=$(yq eval -o=json -I=0 '.' "$scratch/input.yaml" 2>"$scratch/yq.err") ||
    celetis_config_error "<document>: cannot convert YAML to JSON: $(cat "$scratch/yq.err")"
  config=$(printf '%s\n' "$config" | jq -c '
    def field: map(tostring) | join(".") | if . == "" then "<document>" else . end;
    def bad($path; $message): error(($path | field) + ": " + $message);
    def object($path): if type == "object" then . else bad($path; "need an object") end;
    def keys_only($allowed; $path):
      . as $object
      | (first(keys_unsorted[] | select(. as $key | $allowed | index($key) | not)) // null) as $unknown
      | if $unknown == null then $object else bad($path + [$unknown]; "unknown field") end;
    def required($key; $path):
      if has($key) then . else bad($path + [$key]; "required field") end;
    def enum($values; $path):
      if type == "string" and (. as $value | $values | index($value)) != null then .
      else bad($path; "invalid value") end;
    def text($path):
      if type != "string" then bad($path; "need a string")
      elif contains("\u0000") then bad($path; "NUL is not allowed")
      else . end;
    def integer($min; $max; $path):
      if type != "number" then bad($path; "need an integer")
      elif floor != . or . < $min or . > $max then bad($path; "integer is out of range")
      else . end;
    def profile($path):
      object($path) | keys_only(["slots","reviewer"]; $path)
      | required("slots"; $path) | required("reviewer"; $path)
      | (.slots | if type == "array" and length == 4 and
          all(.[]; type == "string" and test("^[A-Za-z0-9][A-Za-z0-9._/-]*$") and
            (explode | all(. >= 32 and . != 127))) then .
          else bad($path + ["slots"]; "need four nonempty model IDs") end) as $slots
      | .reviewer | object($path + ["reviewer"])
      | keys_only(["rank","effort"]; $path + ["reviewer"])
      | required("rank"; $path + ["reviewer"]) | required("effort"; $path + ["reviewer"])
      | (.rank | integer(0; 3; $path + ["reviewer","rank"])) as $rank
      | .effort | enum(["low","medium","high","xhigh"]; $path + ["reviewer","effort"]);
    ["triage","specify","bug","chore","hotfix","plan","implement"] as $steps
    | ["bug","chore","critic-loop","doc-drift-sync","feature","guide","hotfix","implement",
       "intake","lesson","lesson-review","plan","polishing-code-comments","prototype",
       "record-architecture-decisions","setup","specify","triage","writing-for-agents"] as $skills
    | object([]) | keys_only(["host","landing","gates","board","worktreeSetup","custom","codexProfiles"]; [])
    | required("landing"; []) | . as $config
    | [
        (.landing | enum(["pr","merge"]; ["landing"])),
        (if has("host") then .host | enum(["claude","codex"]; ["host"]) else empty end),
        (if has("gates") then .gates | object(["gates"]) | keys_only($steps; ["gates"])
          | to_entries[] | .key as $step | .value | enum(["me","auto"]; ["gates",$step]) else empty end),
        (if has("board") then .board | object(["board"]) | keys_only(["port"]; ["board"])
          | if has("port") then .port | integer(1024; 65535; ["board","port"]) else empty end else empty end),
        (if has("worktreeSetup") then .worktreeSetup | text(["worktreeSetup"]) else empty end),
        (if has("custom") then .custom | object(["custom"]) | keys_only($skills; ["custom"])
          | to_entries[] | .key as $skill | .value | text(["custom",$skill]) else empty end),
        (if has("codexProfiles") then .codexProfiles | object(["codexProfiles"]) | to_entries[]
          | .key as $runtime
          | if $runtime == "" then bad(["codexProfiles"]; "runtime keys must be nonempty") else
              .value | profile(["codexProfiles",$runtime]) end else empty end)
      ] | $config
  ' 2>"$scratch/schema.err") || celetis_config_error "$(cat "$scratch/schema.err")"
  printf '%s\n' "$config"
)

celetis_host_select() {
  local host main config
  if [ $# -gt 0 ]; then
    host=$1
  elif [ "${CELETIS_AGENT+x}" = x ]; then
    host=$CELETIS_AGENT
  else
    host=claude
    if main=$(celetis_config_main 2>/dev/null); then
      config=$(celetis_config_read "$main") || return $?
      host=$(printf '%s\n' "$config" | jq -r '.host // "claude"') || return $?
    fi
  fi
  case $host in
    claude | codex) export CELETIS_AGENT=$host ;;
    *)
      printf 'celetis: invalid agent %s; use claude or codex\n' "$host" >&2
      return 2
      ;;
  esac
}

celetis_session_validate() {
  jq -escS --argjson issue "$1" --arg checkout "$2" '
    if length == 1 then .[0] else error("expected one record") end
    | select(type == "object")
    | select(keys == ["checkout","host","issue","schema","session_id","step"])
    | select(.schema == 1 and .issue == $issue and .checkout == $checkout)
    | select(.host == "claude" or .host == "codex")
    | select(.step | IN("triage","specify","bug","chore","hotfix","plan","implement"))
    | select(.session_id == null or (.session_id | type == "string" and
        test("^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$")))
  '
}

celetis_session_load() {
  local issue=${1#\#} common file
  [[ $issue =~ ^[1-9][0-9]*$ ]] || {
    echo 'celetis: resume needs an issue number' >&2
    return 2
  }
  common=$(git rev-parse --path-format=absolute --git-common-dir) || return 1
  file="$common/celetis-flow/sessions/$issue.json"
  if [ ! -f "$file" ]; then
    printf 'celetis: #%s has no current session record; start a new step with scripts/celetis celetis-flow %s\n' "$issue" "$issue" >&2
    return 1
  fi
  CELETIS_SESSION=$(celetis_session_validate "$issue" "$(dirname "$common")" <"$file" 2>/dev/null) || {
    printf 'celetis: invalid or obsolete session record %s; remove it and start a new step with scripts/celetis celetis-flow %s\n' "$file" "$issue" >&2
    return 1
  }
}

celetis_session_select() {
  local host
  celetis_session_load "$1" || return $?
  host=$(printf '%s\n' "$CELETIS_SESSION" | jq -r .host)
  if [ -n "${2:-}" ] && [ "$2" != "$host" ]; then
    printf 'celetis: #%s recorded host is %s; resume without --agent or use --agent %s\n' "${1#\#}" "$host" "$host" >&2
    return 1
  fi
  celetis_host_select "$host" || return $?
  if ! printf '%s\n' "$CELETIS_SESSION" | jq -e '.session_id != null' >/dev/null; then
    printf 'celetis: #%s has no saved turn with a verified herdr identity; exact runner resume requires herdr identity. From the main checkout, run %s and select the saved session, or start a new step if none exists.\n' "${1#\#}" "$(celetis_manual_recovery)" >&2
    return 1
  fi
}

celetis_manual_recovery() {
  case $CELETIS_AGENT in
    claude) printf 'claude --resume' ;;
    codex) printf 'codex resume --no-daemon' ;;
  esac
}

celetis_codex_reply() {
  local id=$1 method=$2 deadline=$((SECONDS + 10)) line kind remaining
  while :; do
    remaining=$((deadline - SECONDS))
    [ "$remaining" -gt 0 ] || break
    if IFS= read -r -t "$remaining" line <&4; then
      kind=$(printf '%s\n' "$line" | jq -ers --argjson id "$id" '
        if length != 1 or (.[0] | type) != "object" then error("invalid message")
        else .[0] end
        | if has("id") then
            if .id != $id then "other"
            elif .error != null then "error"
            elif (.result | type) == "object" then "result"
            else error("invalid response") end
          elif (.method | type) == "string" then "other"
          else error("invalid notification") end
      ' 2>/dev/null) || {
        echo 'celetis: invalid Codex app-server response' >&2
        return 1
      }
      case $kind in
        result)
          CELETIS_REPLY=$line
          return 0
          ;;
        error)
          printf 'celetis: Codex %s failed: %s\n' "$method" "$(printf '%s\n' "$line" | jq -r '.error.message // "unknown error"')" >&2
          return 1
          ;;
      esac
    else
      if [ "$SECONDS" -lt "$deadline" ]; then
        printf 'celetis: Codex app-server closed its output during %s\n' "$method" >&2
        return 1
      fi
      break
    fi
  done
  printf 'celetis: Codex %s timed out after 10 seconds\n' "$method" >&2
  return 1
}

celetis_codex_request() (
  method=$1 params=$2
  command -v codex >/dev/null 2>&1 || {
    echo 'celetis: codex is not on PATH' >&2
    exit 1
  }
  umask 077
  scratch=$(mktemp -d "${TMPDIR:-/tmp}/celetis.XXXXXX") || exit 1
  codex_pid=
  cleanup() {
    local status=$?
    if [ "$status" -ne 0 ] && [ -f "$scratch/stderr" ]; then cat "$scratch/stderr" >&2; fi
    exec 3>&- 4>&-
    if [ -n "$codex_pid" ]; then
      kill "$codex_pid" 2>/dev/null || true
      for attempt in 1 2 3 4 5; do
        kill -0 "$codex_pid" 2>/dev/null || break
        sleep 0.1
      done
      kill -KILL "$codex_pid" 2>/dev/null || true
      wait "$codex_pid" 2>/dev/null || true
    fi
    rm -rf "$scratch"
  }
  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkfifo "$scratch/in" "$scratch/out" || exit 1
  exec 3<>"$scratch/in" 4<>"$scratch/out"
  codex app-server --stdio <"$scratch/in" >"$scratch/out" 3>&- 4>&- 2>"$scratch/stderr" &
  codex_pid=$!
  exec 4<"$scratch/out"
  printf '%s\n' '{"id":1,"method":"initialize","params":{"clientInfo":{"name":"celetis","version":"0.0.0"},"capabilities":{"experimentalApi":true}}}' >&3
  celetis_codex_reply 1 initialize || exit 1
  printf '%s\n' '{"method":"initialized"}' >&3
  jq -nc --arg method "$method" --argjson params "$params" '{id:2,method:$method,params:$params}' >&3
  celetis_codex_reply 2 "$method" || exit 1
  printf '%s\n' "$CELETIS_REPLY"
)

celetis_codex_root() (
  reply=$(celetis_codex_request skills/list "$(jq -nc --arg cwd "$PWD" '{cwds:[$cwd],forceReload:true}')") || exit 1
  candidates=$(printf '%s\n' "$reply" | jq -ce --arg cwd "$PWD" '
    .result.data
    | if type != "array" then error("invalid data") else . end
    | map(select(.cwd == $cwd))
    | if length != 1 or (.[0].skills | type) != "array" then error("invalid skills") else .[0].skills end
    | map(select(.pluginId == "celetis@celetis" and .enabled == true and
        (.name | type == "string" and test("^celetis:[a-z][a-z-]*$"))))
    | map(. as $skill
        | if (.path | type) != "string" then error("invalid path") else .path end
        | if test("[\u0000-\u001f]") then error("invalid path") else . end
        | if test("^[A-Za-z]:\\\\") then gsub("\\\\"; "/") else . end
        | if test("^(?:/|[A-Za-z]:/).+/skills/[a-z][a-z-]*/SKILL[.]md$") and
            (test("/(?:[.][.]?|)/") | not) then . else error("invalid path") end
        | capture("^(?<root>.+)/skills/(?<skill>[a-z][a-z-]*)/SKILL[.]md$") as $path
        | if ("celetis:" + $path.skill) != $skill.name then error("invalid skill name")
          else {root:$path.root,path:.} end)
  ' 2>/dev/null) || {
    echo 'celetis: invalid Codex skills/list response' >&2
    exit 1
  }
  case $(printf '%s\n' "$candidates" | jq '[.[].root] | unique | length') in
    0)
      echo 'celetis: Codex has no enabled celetis@celetis installation; install and enable the plugin in Codex' >&2
      exit 1
      ;;
    1) ;;
    *)
      echo 'celetis: Codex reports multiple celetis package roots; fix the enabled installation' >&2
      exit 1
      ;;
  esac
  dir=$(printf '%s\n' "$candidates" | jq -r '.[0].root')
  if command -v cygpath >/dev/null 2>&1; then dir=$(cygpath -u "$dir") || exit 1; fi
  if [ ! -d "$dir/scripts" ] || ! jq -e '.name == "celetis"' "$dir/.claude-plugin/plugin.json" >/dev/null 2>&1; then
    echo 'celetis: Codex reports an invalid celetis package; reinstall the plugin' >&2
    exit 1
  fi
  while IFS= read -r path; do
    if command -v cygpath >/dev/null 2>&1; then path=$(cygpath -u "$path") || exit 1; fi
    if [ ! -f "$path" ]; then
      echo 'celetis: Codex reports a missing installed skill; reinstall the plugin' >&2
      exit 1
    fi
  done < <(printf '%s\n' "$candidates" | jq -r '.[].path')
  printf '%s\n' "$dir"
)

celetis_claude_root() {
  local records dir code=0
  if command -v claude >/dev/null 2>&1; then
    records=$(claude plugin list --json) || code=$?
    if [ "$code" -ne 0 ]; then
      printf 'celetis: claude plugin list --json failed (exit %s)\n' "$code" >&2
      [ -z "$records" ] || printf '%s\n' "$records" >&2
      return "$code"
    fi
    if ! printf '%s\n' "$records" | jq -e 'type == "array"' >/dev/null 2>&1; then
      printf 'celetis: invalid plugin list JSON\n%s\n' "$records" >&2
      return 1
    fi
    dir=$(printf '%s\n' "$records" | jq -r '[.[] | select(.id == "celetis@celetis")] | (map(select(.scope == "user")) + .)[0] | select(.enabled == true) | .installPath // empty' | tr -d '\r') || return 1
  else
    dir=
  fi
  if [ -z "$dir" ]; then
    echo 'celetis: the plugin is not installed; run: claude plugin marketplace add ddinkov10/celetis && claude plugin install celetis@celetis' >&2
    return 1
  fi
  if command -v cygpath >/dev/null 2>&1; then dir=$(cygpath -u "$dir") || return 1; fi
  printf '%s\n' "$dir"
}

celetis_main() {
  local name dir main explicit=
  if [ "${1:-}" = --agent ]; then
    if [ $# -lt 3 ]; then
      echo 'usage: scripts/celetis --agent claude|codex <script> [<argument>...]' >&2
      return 2
    fi
    explicit=$2
    celetis_host_select "$explicit" || return $?
    shift 2
  else
    if [ $# -eq 0 ]; then
      echo 'usage: scripts/celetis <script> [<argument>...], e.g. scripts/celetis next-step --open' >&2
      return 2
    fi
  fi
  name=$1
  if ! command -v jq >/dev/null 2>&1; then
    echo 'celetis: jq is not on PATH' >&2
    return 1
  fi
  if [ "$name" = celetis-flow ] && [ $# -eq 3 ] && [ "$2" = --resume ]; then
    celetis_session_select "$3" "$explicit" || return $?
    export CELETIS_RESUME_RECORD=$CELETIS_SESSION
  else
    unset CELETIS_RESUME_RECORD
    celetis_host_select || return $?
  fi
  case $name in
    worktree | celetis-flow | next-step | land | board)
      main=$(celetis_config_main) || return $?
      celetis_config_read "$main" >/dev/null || return $?
      ;;
  esac
  if [ "$CELETIS_AGENT" = codex ]; then
    dir=$(celetis_codex_root) || return 1
  else
    dir=$(celetis_claude_root) || return $?
  fi
  if ! [[ $name =~ ^[a-z][a-z-]*$ ]] || [ ! -f "$dir/scripts/$name.sh" ]; then
    echo "celetis: the plugin has no script $name" >&2
    return 2
  fi
  shift
  exec bash "$dir/scripts/$name.sh" "$@"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then celetis_main "$@"; fi
