# the code assigns empty values in one line on purpose (a= b= c=)
disable=SC1007
# the code uses a && b || c on purpose: c runs when a or b fails, as in check && check || fail
disable=SC2015
# jq, Perl, sed, and shell programs, and Markdown with backticks, are in single quotes on purpose
disable=SC2016
# cases and functions run in subshells on purpose; the flow analysis also reports scratch of scripts/setup.sh, which the main shell sets once
disable=SC2030,SC2031
# the scripts source files by a path that they compute at run time; following them doubled the time of ShellCheck (4.7 s to 9.2 s on 4 cores) for 11 of 13 notes
disable=SC1090,SC1091
